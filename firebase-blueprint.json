{
  "entities": {
    "ClassSchedule": {
      "title": "ClassSchedule",
      "description": "학년, 반, 교시별 수업 교과목 및 담당교사 정보",
      "type": "object",
      "properties": {
        "grade": {
          "type": "number",
          "description": "학년 (1, 2, 3)"
        },
        "classNum": {
          "type": "number",
          "description": "반 번호"
        },
        "period": {
          "type": "number",
          "description": "교시 (2, 3)"
        },
        "subject": {
          "type": "string",
          "maxLength": 100,
          "description": "교과목명"
        },
        "teacher": {
          "type": "string",
          "maxLength": 100,
          "description": "담당교사명"
        },
        "updatedAt": {
          "type": "string",
          "description": "수정일시"
        }
      },
      "required": ["grade", "classNum", "period", "subject", "teacher"]
    },
    "Observation": {
      "title": "Observation",
      "description": "학부모 공개수업 참관록",
      "type": "object",
      "properties": {
        "grade": {
          "type": "number",
          "description": "학년"
        },
        "classNum": {
          "type": "number",
          "description": "반 번호"
        },
        "period": {
          "type": "number",
          "description": "교시"
        },
        "subject": {
          "type": "string",
          "maxLength": 100,
          "description": "수업 교과목"
        },
        "teacher": {
          "type": "string",
          "maxLength": 100,
          "description": "담당교사"
        },
        "content": {
          "type": "string",
          "maxLength": 2000,
          "description": "참관 소감 및 의견"
        },
        "createdAt": {
          "type": "string",
          "description": "작성일시"
        }
      },
      "required": ["grade", "classNum", "period", "content"]
    },
    "SchoolSetting": {
      "title": "SchoolSetting",
      "description": "학교명 및 시스템 설정",
      "type": "object",
      "properties": {
        "schoolName": {
          "type": "string",
          "maxLength": 100,
          "description": "학교명"
        },
        "eventTitle": {
          "type": "string",
          "maxLength": 100,
          "description": "행사명"
        },
        "counts": {
          "type": "object",
          "description": "학년별 반 수 매핑"
        },
        "openClassHomeUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "공개수업 홈으로 이동 웹사이트 URL"
        },
        "openClassHomeButtonText": {
          "type": "string",
          "maxLength": 100,
          "description": "공개수업 홈 이동 버튼 표시 텍스트"
        },
        "updatedAt": {
          "type": "string",
          "description": "수정일시"
        }
      }
    }
  },
  "firestore": {
    "/classes/{classId}": {
      "schema": "ClassSchedule",
      "description": "수업 시간표 컬렉션"
    },
    "/observations/{observationId}": {
      "schema": "Observation",
      "description": "학부모 참관록 컬렉션"
    },
    "/settings/{settingId}": {
      "schema": "SchoolSetting",
      "description": "학교 및 시스템 설정 컬렉션"
    }
  }
}
